{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "HYMetaLab AutoLab Desktop",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "http://127.0.0.1:8787",
    "distDir": "http://127.0.0.1:8787"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "HYMetaLab AutoLab Desktop",
        "width": 1400,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "url": "http://127.0.0.1:8787"
      }
    ],
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.hymetalab.autolabdesktop",
      "shortDescription": "Local-first desktop AutoLab for experiment runs and review.",
      "longDescription": "HYMetaLab AutoLab Desktop launches local AutoLab Studio, manages runs, and supports review workflows for single-user experimentation.",
      "category": "DeveloperTool",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    }
  }
}
